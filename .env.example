# Copy to .env (git-ignored) next to docker-compose.yml and fill in.
# On Dokploy, put the same variables in the application's Environment tab instead.

# Google Maps Platform key with Places API (New), Geocoding API and Routes API enabled.
GOOGLE_MAPS_API_KEY=

# The domain that points at this server, e.g. stations.example.com (HTTPS is automatic).
# Use :80 to serve plain HTTP on the server's IP address instead (testing only).
# (Not used on Dokploy, where Traefik serves the domain.)
DOMAIN=

# ---- Sign-in with Keycloak (see docs/keycloak.md) ----
# The realm URL: the "issuer" shown at <realm URL>/.well-known/openid-configuration.
# Leave empty to run WITHOUT sign-in (anyone who can reach the app can use it).
OIDC_ISSUER=https://keycloak.example.com/realms/station-finder
# The Keycloak client (Client authentication ON) and its secret (Credentials tab).
OIDC_CLIENT_ID=station-finder
OIDC_CLIENT_SECRET=
# The address users open the app at. Keycloak must allow PUBLIC_URL/auth/callback.
PUBLIC_URL=https://stations.example.com
# Users with this role may fix station locations (client role, realm role or group).
OIDC_ADMIN_ROLE=admin
# Optional: only users with this role may sign in (if the realm has other users too).
OIDC_REQUIRED_ROLE=

# Optional: at least 32 random characters, e.g. from `openssl rand -hex 32`.
# Leave empty to let the app generate one and keep it in its data volume.
SESSION_SECRET=
